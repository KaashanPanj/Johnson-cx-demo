# ── Ultravox ───────────────────────────────────────────────────────────────
ULTRAVOX_API_KEY=your_ultravox_api_key_here
# The three Johnson demo agents (created in Ultravox; paste the agent IDs)
# IVR = Mia as the AI-enabled IVR (tabs 1 and 2); RETAIL = Mia as the AI support agent (stage 2 of tab 2); PARTNER = Alex
NEXT_PUBLIC_ULTRAVOX_AGENT_IVR=
NEXT_PUBLIC_ULTRAVOX_AGENT_RETAIL=
NEXT_PUBLIC_ULTRAVOX_AGENT_PARTNER=

# ── OpenAI (post-call field extraction; must be a VALID key) ───────────────
OPENAI_API_KEY=

# ── Google Sheet "customer DB" (one tab per agent) ─────────────────────────
# Create a blank Google Sheet, share it (Editor) with the service-account email,
# then paste the sheet ID from its URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Service-account credentials — ONE of:
#   GOOGLE_SERVICE_ACCOUNT_B64   base64 of the JSON key file (best for Vercel)
#   GOOGLE_SERVICE_ACCOUNT_JSON  the raw JSON string
#   ./google_service_credentials.json  (local dev only; gitignored)
GOOGLE_SERVICE_ACCOUNT_B64=
# Tab names (created + seeded automatically if missing)
SHEET_TAB_RETAIL=Retail Support
SHEET_TAB_PARTNER=Partner Desk

# ── Optional ───────────────────────────────────────────────────────────────
# Timezone used for the injected current date/time and table timestamps
NEXT_PUBLIC_DEMO_TIMEZONE=Australia/Melbourne
